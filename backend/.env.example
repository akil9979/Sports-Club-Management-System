# Champions Club - Backend Environment Configuration Example

PORT=5000
NODE_ENV=development

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_club_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_SSL=false

# JWT Secret & Expiry
JWT_SECRET=champions_club_super_secure_jwt_secret_2026
JWT_EXPIRES_IN=7d

# Debug SQL Queries (true / false)
DEBUG_SQL=false
